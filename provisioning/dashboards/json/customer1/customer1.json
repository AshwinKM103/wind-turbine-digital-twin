{
  "title": "Customer1 Fleet",
  "uid": "customer1-fleet",
  "tags": [
    "fleet",
    "customer1"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "description": "GENERATED by app/tools/generate_grafana_assets.py from app/config/fleet.json. Scoped to customer1 (2 turbines). Use the Turbine dropdown to pick one unit, or 'All turbines' for the whole fleet.",
  "templating": {
    "list": [
      {
        "name": "CUSTOMER_ID",
        "type": "constant",
        "label": "Customer",
        "query": "customer1",
        "current": {
          "text": "customer1",
          "value": "customer1"
        },
        "hide": 2
      },
      {
        "name": "turbine_id",
        "type": "custom",
        "label": "Turbine",
        "multi": false,
        "includeAll": false,
        "query": "All turbines : *, turbine01 : turbine01, turbine02 : turbine02",
        "options": [
          {
            "text": "All turbines",
            "value": "*",
            "selected": false
          },
          {
            "text": "turbine01",
            "value": "turbine01",
            "selected": true
          },
          {
            "text": "turbine02",
            "value": "turbine02",
            "selected": false
          }
        ],
        "current": {
          "text": "turbine01",
          "value": "turbine01",
          "selected": true
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Rotor Speed - $turbine_id",
      "description": "Last reported rotor speed. Green below the normal-operation ceiling of 11975 rpm, red above the overspeed limit of 12270 rpm.",
      "type": "gauge",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "apache-iotdb-datasource",
        "uid": "iotdb-customer1"
      },
      "targets": [
        {
          "refId": "A",
          "sqlType": "SQL: Full Customized",
          "expression": [
            "last_value(TURBINE_SPEED_RPM)"
          ],
          "prefixPath": [
            "root.digitaltwin.customer1.site1.$turbine_id"
          ],
          "condition": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rotrpm",
          "decimals": 0,
          "min": 0,
          "max": 12270,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 11975.2
              },
              {
                "color": "red",
                "value": 12269.6
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*turbine01\\.TURBINE_SPEED_RPM\\)?$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "turbine01 - Turbine Rotor Speed"
              },
