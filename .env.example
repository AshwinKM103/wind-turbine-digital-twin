# Wind Turbine Digital Twin - Configuration Template
# Copy this file to .env and update values for your environment
# DO NOT commit .env to version control - it contains sensitive credentials

# ===== NETWORK BINDING =====
# Every published port in docker-compose.yml binds to this address. Defaults
# to localhost-only -- nothing in this stack has its own auth strong enough
# to be safe on a routable interface (default credentials, plaintext admin
# tokens). Set to 0.0.0.0 only on a trusted private network, never on a
# public host.
BIND_ADDR=127.0.0.1

# ===== LOGGING =====
LOG_LEVEL=DEBUG

# ===== STORAGE - Unified Persistent Data Mount =====
# All containers persist data to this external mount point.
# This keeps the repository clean and allows data to survive container recreation.
# 
# Override to point to persistent storage directory:
#   STORAGE_PATH=/mnt/data3/turbine-digitaltwin
#   STORAGE_PATH=/var/lib/docker-compose/turbine
STORAGE_PATH=/mnt/data3/turbine-digitaltwin

# Directory for provisioning output and device credentials.
# Repo-relative by default so a fresh clone works with no setup; override to
# an absolute path outside the repo for a real deployment.
PROVISIONING_OUTPUT=./provisioning/results

# Directory for OpenBao root token and unseal key. Same portability note as
# PROVISIONING_OUTPUT above.
OPENBAO_SECRETS_DIR=./secrets/openbao


# ===== IOTDB - Deployment Configuration =====
# Image version: change to upgrade IoTDB across environments
IOTDB_VERSION=1.3.3-standalone
# Note: Data persistence paths now use STORAGE_PATH defined above
# (IOTDB_DATA_PATH and IOTDB_LOGS_PATH are now derived from STORAGE_PATH in docker-compose.yml)

# ===== IOTDB - Client Connection =====
# Used by kafka-consumer.py and Grafana provisioning to write/read time-series data
# For local dev: localhost (running outside Docker)
# For Docker networking: use service name (iotdb) when running inside container
IOTDB_HOST=localhost
IOTDB_PORT=6667
IOTDB_USER=root
IOTDB_PASSWORD=root

# ===== POSTGRES - Alerts & KPI store =====
# Holds confirmed alerts, threshold breaches and the turbine operating-state
# timeline. Read by Thingsboard's dashboards and widgets; written by the
# anomaly detector. Schema: app/config/postgres-schema.sql
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=turbine
POSTGRES_USER=turbine
# The application (read-write) password. Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=turbine_dev_password
# Password for the per-tenant read-only role (grafana_zephyr-energy) and the
# admin reader role (grafana_admin_reader) defined in
# provisioning/postgres/tenant-views.sql. Separate from the one above so a
# leaked dashboard credential cannot write to the alert history.
POSTGRES_GRAFANA_PASSWORD=grafana_dev_password
# Host port for the container's 5432. Changed from the default because a
# developer machine commonly already runs Postgres on 5432.
POSTGRES_PORT_HOST=15432
# Set false to run the detector with no alert persistence (Kafka only).
POSTGRES_ENABLED=true
# Retention for alerts, breaches and closed state rows. Enforced hourly by
# prune_retention() -- see app/config/postgres-schema.sql.
POSTGRES_RETENTION_DAYS=30

# ===== TURBINE STATE TIMELINE =====
# An inferred state must hold this long before it is written to
# turbine_states. Debounces the per-sample RPM inference, which flickers
# across the IDLE/RAMP_UP boundary during spin-up.
STATE_STABILITY_SECONDS=30
# No telemetry for this long => the turbine is recorded as DOWN.
# Must be greater than STATE_STABILITY_SECONDS.
STATE_STALE_SECONDS=120

# ===== KAFKA - Message Broker =====
# External (host): used by producer/consumer running outside Docker
# Internal (container): used when producer/consumer run inside Docker network
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka:29092
KAFKA_TOPIC=turbine.telemetry.raw.v1
DLQ_TOPIC=turbine.telemetry.dlq
KAFKA_GROUP_ID=iotdb-writer-group
# Consumer group for kafka-mqtt-bridge
KAFKA_GROUP_ID_MQTT=kafka-mqtt-bridge-group


# ===== SYNTHETIC GENERATOR - Turbine identity =====
# Set per generator container in docker-compose.yml, not globally.
# CUSTOMER_ID / SITE_ID / TURBINE_ID together form the IoTDB device path:
# root.digitaltwin.<CUSTOMER_ID>.<SITE_ID>.<TURBINE_ID>
# The fleet topology lives in app/config/fleet.json.
# These are shown here for reference; actual values are set by generate_compose_generators.py.
# CUSTOMER_ID=zephyr-energy
# SITE_ID=cascade-ridge
# TURBINE_ID=boreas

# ===== SYNTHETIC GENERATOR - Operating state machine =====
# Seconds spent in each state before advancing. Defaults give a ~14-minute
# duty cycle dominated by STEADY_STATE, matching a real turbine.
STATE_IDLE_DURATION_S=60
STATE_RAMP_UP_DURATION_S=120
STATE_STEADY_DURATION_S=600
STATE_RAMP_DOWN_DURATION_S=90

# ===== TUNING - Data Pipeline Performance =====
# Telemetry sample rate, in seconds per sample, for each turbine generator
SAMPLE_INTERVAL_S=1.0
# Log one "Produced telemetry" line every N samples
PRODUCE_LOG_EVERY_N=30

# Consumer batching: how many rows to buffer before IoTDB flush
# Note: At 1 Hz + BATCH_MAX_WAIT_S=5.0, timeout fires first (~5 rows per flush)
BATCH_SIZE=50
BATCH_MAX_WAIT_S=5.0

# Circuit breaker: when IoTDB connection fails
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_S=30.0

# Retry strategy: exponential backoff for failed writes
IOTDB_WRITE_MAX_RETRIES=3
IOTDB_WRITE_BACKOFF_BASE_S=0.2

# ===== LOGGING =====
# Directory for structured JSON logs (bind-mounted from ./app/logs)
LOG_DIR=./logs

# ===== THINGSBOARD CE - Phase 1 PoC (docker-compose-phase1.yml) =====
# Device management platform for multi-tenant IoT data ingestion and visualization.
# Configure only if running Phase 1 PoC with: docker compose -f docker-compose.yml -f docker-compose-phase1.yml
#
# Thingsboard PostgreSQL (separate from alerts/KPI PostgreSQL on 5432)
# Used internally for device registry, dashboards, audit logs.
# Password: generate with: openssl rand -base64 24
# MUST be changed in production before any external access.
TB_POSTGRES_PASSWORD=thingsboard_dev_password
# Host port for Thingsboard's PostgreSQL container (5432 inside → 15433 on host)
TB_POSTGRES_PORT_HOST=15433

# ===== THINGSBOARD PROVISIONING =====
# REST API connection details for automated provisioning scripts (app/tools/provision_*.py)
# Hostname: use 'thingsboard' within Docker network or 'localhost' from host machine
TB_HOST=thingsboard
TB_PORT=8080
# ThingsBoard's sysadmin account starts as sysadmin@thingsboard.org/sysadmin
# (the OSS image's fixed install default, not configurable via env vars at
# install time). Set a real password below -- the thingsboard-secure-admin
# compose service rotates the live account to match this value on first
# boot, and every provisioning script authenticates using what's here.
TB_SYSADMIN_EMAIL=sysadmin@thingsboard.org
TB_SYSADMIN_PASSWORD=changeme-generate-a-real-password

# ===== TENANT PROVISIONING =====
# Default tenant parameters for single-tenant provisioning scripts
TENANT_NAME=zephyr-energy
TENANT_EMAIL=zephyr-energy_admin@example.com
# Tenant administrator password for ThingsBoard authentication
TB_TENANT_ADMIN_PASSWORD=changeme-generate-a-real-tenant-password
SITE_ID=cascade-ridge
# Comma-separated list of turbine IDs to provision under the tenant site
TURBINE_IDS=boreas

# Host uid/gid that owns provisioning/results/device-tokens.json (mode 0600).
# The kafka-mqtt-bridge container runs as this user so it can read that file.
HOST_UID=1000
HOST_GID=1000

# ===== LOCAL LLM (VLLM) - Turbine Copilot ======
# API key for vLLM OpenAI-compatible endpoint.
# Generate a random key locally (e.g., with `openssl rand -base64 32`).
# DO NOT commit a real value to version control.
# Production deployments should source this from OpenBao (see app/secrets_loader.py)
# like other secrets in this stack.
VLLM_API_KEY=
# Model name to serve via vLLM (must fit in available GPU memory).
# Qwen2.5-0.5B-Instruct is the default: a small local model that runs comfortably
# on a single GPU and still supports OpenAI-style tool calling (--tool-call-parser hermes).
# Change this to swap models without editing docker-compose.yml.
VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
