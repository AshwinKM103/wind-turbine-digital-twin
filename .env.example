# Wind Turbine Digital Twin - Configuration Template
# Copy this file to .env and update values for your environment
# DO NOT commit .env to version control - it contains sensitive credentials

# ===== ENVIRONMENT =====
# Set to 'development' for local work (verbose logs, weak credentials OK)
# Set to 'production' for deployments (strict validation, secure credentials required)
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# ===== IOTDB - Deployment Configuration =====
# Image version: change to upgrade IoTDB across environments
IOTDB_VERSION=1.3.3-standalone
# Data persistence paths: override for NFS mounts or custom storage
IOTDB_DATA_PATH=./data/iotdb/data
IOTDB_LOGS_PATH=./data/iotdb/logs

# ===== IOTDB - Client Connection =====
# Used by kafka-consumer.py and Grafana provisioning to write/read time-series data
# For local dev: localhost (running outside Docker)
# For Docker networking: use service name (iotdb) when running inside container
IOTDB_HOST=localhost
IOTDB_PORT=6667
IOTDB_USER=root
IOTDB_PASSWORD=root

# ===== KAFKA - Message Broker =====
# External (host): used by producer/consumer running outside Docker
# Internal (container): used when producer/consumer run inside Docker network
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka:29092
KAFKA_TOPIC=turbine.telemetry.raw.v1
DLQ_TOPIC=turbine.telemetry.dlq
KAFKA_GROUP_ID=iotdb-writer-group

# ===== DOCKER NETWORKING (advanced) =====
# Override if deploying in environments with subnet conflicts
# Only modify if you have network conflicts with other Docker bridges
IOTDB_SUBNET=172.20.0.0/16
IOTDB_GATEWAY=172.20.0.1

# ===== SYNTHETIC GENERATOR - Turbine identity =====
# Set per generator container in docker-compose.yml, not globally.
# CUSTOMER_ID / SITE_ID / TURBINE_ID together form the IoTDB device path:
# root.digitaltwin.<CUSTOMER_ID>.<SITE_ID>.<TURBINE_ID>
# The fleet topology lives in app/config/fleet.json.
# These are shown here for reference; actual values are set by generate_compose_generators.py.
# CUSTOMER_ID=customer1
# SITE_ID=site1
# TURBINE_ID=turbine01

# ===== SYNTHETIC GENERATOR - Operating state machine =====
# Seconds spent in each state before advancing. Defaults give a ~14-minute
# duty cycle dominated by STEADY_STATE, matching a real turbine.
STATE_IDLE_DURATION_S=60
STATE_RAMP_UP_DURATION_S=120
STATE_STEADY_DURATION_S=600
STATE_RAMP_DOWN_DURATION_S=90

# ===== TUNING - Data Pipeline Performance =====
# Telemetry sample rate, in seconds per sample, for each turbine generator
SAMPLE_INTERVAL_S=1.0
# Log one "Produced telemetry" line every N samples
PRODUCE_LOG_EVERY_N=30

# Consumer batching: how many rows to buffer before IoTDB flush
# Note: At 1 Hz + BATCH_MAX_WAIT_S=5.0, timeout fires first (~5 rows per flush)
BATCH_SIZE=50
BATCH_MAX_WAIT_S=5.0

# Circuit breaker: when IoTDB connection fails
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_S=30.0

# Retry strategy: exponential backoff for failed writes
IOTDB_WRITE_MAX_RETRIES=3
IOTDB_WRITE_BACKOFF_BASE_S=0.2

# ===== LOGGING =====
# Directory for structured JSON logs (bind-mounted from ./app/logs)
LOG_DIR=./logs

# ===== GRAFANA - Dashboard UI =====
# Username and password for accessing Grafana dashboard at http://localhost:13000
# In production, use strong passwords: openssl rand -base64 16
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Password assigned to every customer login created by scripts/setup_grafana_orgs.py
# Change this before any real deployment; it is a shared demo credential.
CUSTOMER_USER_PASSWORD=customer123
